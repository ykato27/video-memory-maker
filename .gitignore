# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Temporary files
temp/
*.temp.mp4

# Input/Output videos (keep folder structure with .gitkeep)
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# Videos (generated/input media is not tracked)
*.mp4

# MediaPipe models (auto-downloaded on first run)
assets/*.tflite
assets/*.task

# Fonts (not bundled; place manually if needed)
assets/*.ttf

# Audio files (user-provided, not tracked)
assets/*.aac
assets/*.mp3
bgm/

# Generated JSON files
*.json

# IDE
.idea/
.vscode/
*.swp

# OS files
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/
